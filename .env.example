# ============================================================================
# Nyaa Chat Server Environment Variables (.env.example)
# ============================================================================
# 실제 배포 시 이 파일을 .env 로 복사한 뒤 비밀번호와 포트를 설정하세요.
# .env 파일은 Git 저장소에 절대 커밋되지 않도록 .gitignore에 등록되어 있습니다.

# 서버 포트 (기본값: 3000)
PORT=3000

# 서버 총괄 관리자 (/oper) 계정 설정
OPER_USER=
OPER_PASS=change_this_to_your_secure_password

# 공인 AI 운영자 (/aioper) 비밀번호 설정 (선택 사항)
# 미설정 시 data/aioper_accounts.json 파일에서 개별 관리됩니다.
# AIOPER_NEMULO_PW=
# AIOPER_NEMU_PW=
# AIOPER_KOKO_PW=

# 실행 환경 (production 또는 development)
NODE_ENV=production
